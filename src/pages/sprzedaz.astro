---
import Base from '../layouts/Base.astro';
import Chero from '../components/Chero.astro';
import Naglowek from '../components/Naglowek.astro';
import ProcesKola from '../components/ProcesKola.astro';
import Faq from '../components/Faq.astro';
import Telefon from '../components/Telefon.astro';
import FormularzSzukam from '../components/FormularzSzukam.astro';
import { okruszki, faqLd, FIRMA } from '../dane/firma';

const FAQ: [string, string][] = [
  ['Gdzie znajdę aktualną ofertę?', 'Aktualne samochody prezentujemy na profilu firmy na Facebooku. Możesz również zadzwonić pod numer 692 493 797 lub 693 649 549 i powiedzieć, jakiego auta szukasz.'],
  ['Czy TINA jest komisem samochodowym?', 'Nie. Sprzedajemy samochody, które wcześniej sami odkupiliśmy i które należą do naszej firmy.'],
  ['Czy mogę odbyć jazdę próbną?', 'Tak. Oględziny i jazdę próbną ustalamy wcześniej telefonicznie, aby zarezerwować odpowiednią ilość czasu.'],
  ['Czy mogę sprawdzić samochód przed zakupem?', 'Tak. Zachęcamy do dokładnego obejrzenia pojazdu i zadawania pytań dotyczących jego stanu.'],
  ['Czy przyjmujecie samochody w rozliczeniu?', 'Tak. Prowadzimy skup samochodów, dlatego możemy wycenić Twoje obecne auto i rozliczyć je przy zakupie innego pojazdu.'],
];

const ZAKUP: [string, string][] = [
  ['Sprawdzasz aktualną ofertę', 'Zadzwoń lub odwiedź nasz profil na Facebooku, aby dowiedzieć się, jakie samochody są obecnie dostępne.'],
  ['Umawiasz oględziny', 'Ustalamy dogodny termin spotkania w naszej bazie w Kozłowie Biskupim pod Sochaczewem.'],
  ['Oglądasz samochód', 'Możesz spokojnie obejrzeć pojazd, uruchomić go i odbyć jazdę próbną. Odpowiemy również na pytania dotyczące jego stanu.'],
  ['Podejmujesz decyzję', 'Jeżeli samochód spełnia Twoje oczekiwania, przygotowujemy dokumenty i finalizujemy sprzedaż.'],
];
---
<Base
  title="Samochody używane na sprzedaż — auta z naszego skupu | TINA"
  description="Sprzedajemy samochody, które wcześniej sami odkupiliśmy. Nie jesteśmy komisem — auta należą do nas, więc znamy ich stan. Oględziny i jazda próbna po umówieniu."
  path="/sprzedaz"
  schema={[okruszki([['/sprzedaz', 'Samochody na sprzedaż']]), faqLd(FAQ)]}
  cta={{ label: 'Zapytaj o auto', href: `tel:${FIRMA.tel1tel}` }}
>

<Chero
  okruszek="Samochody na sprzedaż"
  lede="Sprzedajemy samochody, które wcześniej sami odkupiliśmy. Nie działamy jako komis — oferowane auta należą do nas, dlatego możemy rzeczowo opowiedzieć o ich stanie i odpowiedzieć na pytania dotyczące konkretnego egzemplarza."
  sub="Oględziny i jazdę próbną umawiamy telefonicznie."
>
  <span>Samochody używane <span class="gold">na sprzedaż</span></span>
  <Fragment slot="akcje">
    <a class="btn g" href="#zapytanie">Zapytaj o dostępne auta</a>
    <Telefon />
  </Fragment>
</Chero>

<div class="w"><section>
  <div class="proza">
    <h2>Auto, które możesz dokładnie sprawdzić</h2>
    <p>Zakup używanego samochodu wymaga spokojnej decyzji. Dlatego przed zakupem możesz dokładnie obejrzeć auto, uruchomić silnik, zajrzeć pod maskę i odbyć jazdę próbną.</p>
    <p>Przekazujemy informacje, które posiadamy o pojeździe, w tym również o widocznych śladach użytkowania lub elementach wymagających uwagi. Zależy nam, aby kupujący wiedział, jaki samochód wybiera.</p>
  </div>
</section></div>

<div class="darker"><div class="w"><section>
  <Naglowek
    eyebrow="Nasze auta"
    tytul='Bez <span class="gold">pośredników</span>'
  />
  <div class="proza" style="color:var(--onk-mut)">
    <p style="color:var(--onk-mut)">Samochody znajdujące się w naszej ofercie zostały wcześniej odkupione przez firmę TINA. Nie pośredniczymy pomiędzy właścicielem a kupującym i nie opieramy się wyłącznie na treści pozostawionej przez osobę wystawiającą ogłoszenie.</p>
    <p style="color:var(--onk-mut)">Każde auto trafia najpierw do nas. Dzięki temu możemy je wcześniej zobaczyć, sprawdzić podczas jazdy i przygotować konkretne informacje dla kolejnego właściciela.</p>
  </div>
</section></div></div>

<div class="w"><section>
  <Naglowek
    eyebrow="Oferta"
    tytul='Jakie samochody znajdziesz <span class="gold">w ofercie?</span>'
    opis="Oferta zmienia się na bieżąco. Trafiają do nas samochody osobowe różnych marek, roczników i typów nadwozia, a także auta dostawcze i busy."
  />
  <div class="docs">
    <div class="doc"><b>Samochody miejskie</b><p>Małe, zwrotne i tanie w utrzymaniu. Do codziennych dojazdów, nauki jazdy i parkowania tam, gdzie większe auto się nie zmieści.</p></div>
    <div class="doc"><b>Sedany, kombi i hatchbacki</b><p>Najszerszy wybór na rynku wtórnym. Kombi, gdy liczy się bagażnik, sedan do trasy, hatchback jako uniwersalne auto do wszystkiego.</p></div>
    <div class="doc"><b>SUV-y i auta terenowe</b><p>Wyższe zawieszenie, wygodniejsze wsiadanie, część z napędem na cztery koła. Sprawdzają się poza asfaltem i zimą.</p></div>
    <div class="doc"><b>Samochody rodzinne</b><p>Pięć pełnowymiarowych miejsc, duży bagażnik i zaczepy na foteliki. Auta pomyślane o wyjazdach z dziećmi i bagażem.</p></div>
    <div class="doc"><b>Auta dostawcze i busy</b><p>Furgony, blaszaki, brygadówki i busy dziewięcioosobowe do 3,5 tony — do pracy, przeprowadzki albo przewozu ludzi.</p></div>
    <div class="doc"><b>Różne przedziały cenowe</b><p>Od tanich aut na start, przez środek rynku, po droższe egzemplarze. Powiedz, jaki masz budżet, a sprawdzimy, co w nim mamy.</p></div>
  </div>

  <div class="proza" style="margin-top:36px">
    <p>Nie prowadzimy stałego katalogu, ponieważ część samochodów znajduje nowych właścicieli niedługo po przyjęciu. Aktualną dostępność najlepiej sprawdzić telefonicznie lub na profilu firmy na Facebooku.</p>
  </div>
</section></div>

<div class="w"><section>
  <Naglowek eyebrow="Krok po kroku" tytul='Jak wygląda <span class="gold">zakup samochodu?</span>' />
  <ProcesKola kroki={ZAKUP} />
</section></div>

<div class="w"><section>
  <div class="duo">
    <div class="box">
      <h3>Zostaw swoje auto w rozliczeniu</h3>
      <p>Chcesz kupić inny samochód, ale najpierw musisz sprzedać obecny? Prowadzimy również skup aut, dlatego możemy wycenić Twój samochód i odkupić go w ramach jednej transakcji.</p>
      <p style="margin-top:12px">Po oględzinach ustalamy wartość obecnego auta, a następnie rozliczamy różnicę. Powiedz o takiej możliwości już podczas pierwszej rozmowy — przygotujemy wstępną wycenę i ustalimy dalsze kroki.</p>
      <div class="acts" style="margin-top:20px"><a class="btn g" href="/wycena">Wycena auta online</a></div>
    </div>
    <div class="box">
      <h3>Aktualne samochody na Facebooku</h3>
      <p>Zdjęcia wybranych samochodów dostępnych w sprzedaży publikujemy na profilu TINA Skup Aut. Ponieważ oferta zmienia się dynamicznie, dostępność konkretnego pojazdu warto potwierdzić telefonicznie.</p>
      <div class="acts" style="margin-top:20px"><a class="btn o" href={FIRMA.fb} rel="noopener" target="_blank">Zobacz profil TINA Skup Aut</a></div>
    </div>
  </div>
</section></div>

<div class="w"><section>
  <Naglowek eyebrow="Pytania" tytul='Najczęściej zadawane <span class="gold">pytania</span>' />
  <Faq pary={FAQ} />
</section></div>

<FormularzSzukam />

</Base>
