---
import Base from '../layouts/Base.astro';
import { FIRMA } from '../dane/firma';
---
<Base
  title="Zgłoszenie przyjęte | TINA Skup Aut"
  description="Dziękujemy za zgłoszenie. Oddzwonimy na podany numer telefonu."
  path="/dziekujemy"
  noindex
>

<div class="chero">
  <div class="w">
    <p class="crumb"><a href="/">TINA</a> / Zgłoszenie przyjęte</p>
    <h1>Zgłoszenie <span class="gold">przyjęte</span></h1>
    <p class="lede" id="dz-lede">Oddzwaniamy zwykle tego samego dnia.</p>
    <div class="acts"><a class="btn g" href={`tel:${FIRMA.tel1tel}`}>Zadzwoń teraz: {FIRMA.tel1}</a></div>
  </div>
</div>

<div class="w"><section><div class="dziek">
  <p style="color:var(--muted);font-size:16.5px">
    Zgłoszenie trafiło prosto do nas, nie do żadnej centrali ani pośrednika. Odezwiemy się na podany
    numer, żeby dopytać o szczegóły i podać konkretną kwotę.
  </p>
  <p style="margin-top:16px;color:var(--muted);font-size:16.5px">
    Jeśli spieszysz się ze sprzedażą, nie czekaj na nasz telefon. Zadzwoń pod
    <a href={`tel:${FIRMA.tel1tel}`} style="color:var(--g4);font-weight:700">{FIRMA.tel1}</a>
    albo <a href={`tel:${FIRMA.tel2tel}`} style="color:var(--g4);font-weight:700">{FIRMA.tel2}</a>,
    ustalimy kwotę od ręki.
  </p>
  <div class="acts">
    <a class="btn k" href="/">Wróć na stronę główną</a>
    <a class="btn o" style="color:var(--ink);border-color:var(--line)" href="/realizacje">Zobacz, co odkupiliśmy</a>
  </div>
</div></section></div>

<script is:inline>
/* Jesli formularz przekazal marke auta i numer telefonu, personalizujemy zdanie u gory. */
(function () {
  var q = new URLSearchParams(location.search);
  var a = q.get('a'), t = q.get('t');
  if (!a && !t) return;
  var l = document.getElementById('dz-lede');
  if (l) l.textContent = (a ? a + ', o' : 'O') + 'ddzwaniamy' + (t ? ' pod ' + t : '') + ', zwykle tego samego dnia.';
})();
</script>

</Base>
