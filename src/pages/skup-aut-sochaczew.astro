---
import Base from '../layouts/Base.astro';
import Chero from '../components/Chero.astro';
import Naglowek from '../components/Naglowek.astro';
import Kroki from '../components/Kroki.astro';
import Formularz from '../components/Formularz.astro';
import Cta from '../components/Cta.astro';
import Faq from '../components/Faq.astro';
import { okruszki, faqLd } from '../dane/firma';

const FAQ: [string, string][] = [
  ['Gdzie dokładnie jesteście?', 'Bazę mamy w Kozłowie Biskupim pod Sochaczewem, przy ulicy Przyszłej 2B. Nie musisz jednak tu przyjeżdżać — to my przyjeżdżamy pod wskazany adres.'],
  ['Ile czekam na przyjazd w Sochaczewie i okolicy?', 'Zwykle jesteśmy tego samego dnia, w którym dzwonisz. W samym Sochaczewie i sąsiednich gminach to kwestia najbliższych godzin.'],
  ['Czy muszę przyjechać do was z autem?', 'Nie. Przyjeżdżamy pod dom, pod warsztat albo w miejsce, w którym auto stoi. Jeśli nie jeździ, przywozimy lawetę.'],
  ['Odbierzecie auto z gminy poza Sochaczewem?', 'Tak. Obsługujemy cały powiat sochaczewski i całe Mazowsze. Dojazd jest bezpłatny niezależnie od odległości.'],
];
---
<Base
  title="Skup aut Sochaczew — auto skup, gotówka od ręki | TINA"
  description="Skup samochodów w Sochaczewie i całym powiecie. Baza w Kozłowie Biskupim, przyjazd zwykle w godzinę, dojazd i laweta bezpłatne, płatność na miejscu."
  path="/skup-aut-sochaczew"
  schema={[okruszki([['/skup-aut-sochaczew', 'Skup aut Sochaczew']]), faqLd(FAQ)]}
>

<Chero
  okruszek="Skup aut Sochaczew"
  lede="Jesteśmy stąd. Baza w Kozłowie Biskupim, kilka minut od Sochaczewa — w mieście i okolicznych gminach jesteśmy zwykle w ciągu godziny od telefonu."
  sub="Skup samochodów w Sochaczewie i całym powiecie sochaczewskim."
><span>Skup aut <span class="gold">Sochaczew</span></span></Chero>

<div class="w"><section>
  <div class="proza">
    <h2>Skup aut na miejscu, nie z drugiego końca Polski</h2>
    <p>Sporą część ogłoszeń o skupie aut w Sochaczewie wystawiają firmy, które są tu wyłącznie na papierze — numer telefonu jest warszawski albo łódzki, a przyjazd trzeba umówić na przyszły tydzień, bo ktoś musi „ułożyć trasę”. My mamy bazę w Kozłowie Biskupim przy ulicy Przyszłej, czyli kilka minut od centrum Sochaczewa.</p>
    <p>W praktyce oznacza to jedno: w Sochaczewie i sąsiednich gminach jesteśmy zwykle w ciągu godziny od rozmowy, a nie następnego dnia. Nie musimy nic układać w trasę, bo to jest nasza trasa codziennie.</p>

    <h2>Gdzie odbieramy auta w powiecie</h2>
    <p>Obsługujemy cały powiat sochaczewski — miasto i gminę Sochaczew oraz gminy Teresin, Rybno, Nowa Sucha, Iłów, Młodzieszyn, Brochów i Kampinos. Regularnie jeździmy też w stronę Żyrardowa, Błonia, Łowicza i Wyszogrodu.</p>
    <p>Przyjeżdżamy pod adres, który podasz. Może to być podwórko pod domem, parking pod blokiem na Chodakowie czy Trojanowie, warsztat, w którym auto stoi po naprawie, albo działka, na której samochód nie ruszał się od dwóch lat. Przy autach stojących długo bez ruchu zawsze bierzemy lawetę — nawet jeśli teoretycznie odpalają.</p>
  </div>

  <div class="local" style="margin-top:26px">
    <div class="box">
      <h3>Powiat sochaczewski</h3>
      <div class="near">
        <span>Sochaczew</span><span>Chodaków</span><span>Trojanów</span><span>Boryszew</span>
        <span>Teresin</span><span>Rybno</span><span>Nowa Sucha</span><span>Iłów</span>
        <span>Młodzieszyn</span><span>Brochów</span><span>Kampinos</span><span>Kozłów Biskupi</span>
      </div>
      <p style="margin-top:16px;font-size:15px;color:#5a616e">Jeśli Twojej miejscowości tu nie ma, zadzwoń mimo wszystko. Jeździmy po całym Mazowszu, a nie tylko po powiecie.</p>
    </div>
    <div class="box">
      <h3>Dalej na Mazowszu</h3>
      <div class="near">
        <a href="/skup-aut-warszawa">Warszawa</a>
        <span>Żyrardów</span><span>Grodzisk Mazowiecki</span><span>Błonie</span>
        <span>Ożarów Mazowiecki</span><span>Nowy Dwór Mazowiecki</span><span>Płock</span><span>Łowicz</span>
      </div>
      <p style="margin-top:16px;font-size:15px;color:#5a616e">Dojazd i laweta kosztują zero złotych niezależnie od tego, jak daleko jedziemy. Nie doliczamy kilometrów do wyceny.</p>
    </div>
  </div>

  <div class="proza" style="margin-top:44px">
    <h2>Co najczęściej odkupujemy w okolicy</h2>
    <p>Struktura zgłoszeń w Sochaczewie i okolicznych gminach wygląda inaczej niż w dużym mieście. Trafia do nas sporo aut z przebiegami, które w Warszawie byłyby nie do pomyślenia — bo tutaj samochód służy do codziennych dojazdów w stronę stolicy i nabija po czterdzieści tysięcy kilometrów rocznie.</p>
    <p>Druga rzecz to auta stojące. Samochód po zmarłym krewnym, który od kilku lat stoi pod wiatą. Drugie auto w rodzinie, które przestało być potrzebne, gdy dzieci wyjechały. Dostawczak po zamkniętej działalności. W każdym z tych przypadków im dłużej auto stoi, tym mniej jest warte — zostawione na dworze traci wyraźnie z roku na rok.</p>

    <h2>Dlaczego nie wystawiać ogłoszenia</h2>
    <p>Sprzedaż prywatna w mniejszym mieście ma jedną specyficzną wadę: rynek lokalny jest mały, więc albo czekasz tygodniami na kogoś z okolicy, albo umawiasz się z ludźmi, którzy przyjadą z daleka i będą chcieli zbić cenę za sam dojazd. Do tego dochodzi to, co wszędzie — telefony o nieludzkich porach, oglądacze, którzy się nie pojawiają, i pytanie „ostateczna cena?” przy pierwszym kontakcie.</p>
    <p>Skup nie da tyle, ile najlepsza sprzedaż prywatna po miesiącu szukania. Da natomiast konkretną kwotę dziś, bez ogłoszenia, bez jazdy próbnej z nieznajomym i bez czekania na przelew.</p>
  </div>

  <Kroki />
</section></div>

<div class="w"><section>
  <Naglowek eyebrow="Pytania" tytul='Sochaczew i okolice — <span class="gold">pytania</span>' />
  <Faq pary={FAQ} />
</section></div>

<Formularz strona="sochaczew" />
<Cta
  tytul='Sprzedaj auto <span class="gold">w Sochaczewie</span>'
  opis="Jesteśmy stąd, więc zwykle jesteśmy u Ciebie tego samego dnia. Dojazd i laweta nic nie kosztują."
/>

</Base>
