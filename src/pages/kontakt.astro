---
import Base from '../layouts/Base.astro';
import Chero from '../components/Chero.astro';
import Naglowek from '../components/Naglowek.astro';
import Formularz from '../components/Formularz.astro';
import Telefon from '../components/Telefon.astro';
import { okruszki, FIRMA, FIRMA_LD } from '../dane/firma';
---
<Base
  title="Kontakt | TINA Skup Aut, Sochaczew i całe Mazowsze"
  description="Telefon, e-mail i adres. Odbieramy 7 dni w tygodniu, przyjeżdżamy pod wskazany adres na terenie całego Mazowsza."
  path="/kontakt"
  schema={[FIRMA_LD, okruszki([['/kontakt', 'Kontakt']])]}
>

<Chero
  okruszek="Kontakt"
  lede="Zadzwoń, napisz lub prześlij formularz wyceny. Opowiedz nam o samochodzie, a odpowiemy na pytania, wstępnie ocenimy pojazd i ustalimy dogodny termin oględzin."
  sub="Działamy siedem dni w tygodniu i dojeżdżamy pod wskazany adres na terenie całego Mazowsza."
  akcje={false}
><span>Porozmawiajmy <span class="gold">o Twoim aucie</span></span></Chero>

<div class="w"><section>
  <div class="local">
    <div class="box">
      <h3>Wybierz wygodny sposób kontaktu</h3>
      <p style="margin-bottom:18px">Zadzwoń, jeśli zależy Ci na szybkiej rozmowie, albo prześlij formularz, aby od razu przekazać podstawowe informacje i zdjęcia samochodu. Odezwiemy się i ustalimy kolejne kroki.</p>
      <div class="acts para"><Telefon /><a class="btn k" href="/wycena">Formularz wyceny</a></div>
      <dl class="dane">
        <div><dt>Telefon</dt><dd><a href={`tel:${FIRMA.tel1tel}`}>{FIRMA.tel1}</a></dd></div>
        <div><dt>Drugi numer</dt><dd><a href={`tel:${FIRMA.tel2tel}`}>{FIRMA.tel2}</a></dd></div>
        <div><dt>E-mail</dt><dd><a href={`mailto:${FIRMA.mail}`}>{FIRMA.mail}</a></dd></div>
        <div><dt>Facebook</dt><dd><a href={FIRMA.fb} rel="noopener" target="_blank">Skup Aut TINA</a></dd></div>
        <div><dt>Adres</dt><dd>{FIRMA.podmiot}<br>{FIRMA.ulica}, {FIRMA.kod} {FIRMA.miasto}<br>powiat sochaczewski, woj. mazowieckie</dd></div>
        <div><dt>Dane firmy</dt><dd>NIP {FIRMA.nip}<br>REGON {FIRMA.regon}</dd></div>
        <div><dt>Kiedy dzwonić</dt><dd>7 dni w tygodniu, także w weekendy</dd></div>
        <div><dt>Obszar</dt><dd>Całe Mazowsze</dd></div>
      </dl>
    </div>
    <div class="mapka">
      <iframe
        title="Mapa dojazdu: Przyszła 2B, Kozłów Biskupi pod Sochaczewem"
        src="https://www.openstreetmap.org/export/embed.html?bbox=20.1650,52.1700,20.2170,52.1945&layer=mapnik&marker=52.1822213,20.1908621"
        loading="lazy"
        referrerpolicy="no-referrer"
      ></iframe>
      <a class="mapka-link" href="https://www.google.com/maps/dir/?api=1&destination=52.1822213,20.1908621" rel="noopener" target="_blank">Wyznacz trasę</a>
    </div>
  </div>
</section></div>

<Formularz strona="kontakt" />

</Base>
