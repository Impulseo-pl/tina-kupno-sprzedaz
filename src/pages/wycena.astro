---
import Base from '../layouts/Base.astro';
import Chero from '../components/Chero.astro';
import Naglowek from '../components/Naglowek.astro';
import Formularz from '../components/Formularz.astro';
import Faq from '../components/Faq.astro';
import { okruszki, faqLd } from '../dane/firma';

const FAQ: [string, string][] = [
  ['Czy wysłanie formularza jest bezpłatne?', 'Tak. Wycena jest bezpłatna i nie zobowiązuje Cię do sprzedaży samochodu. Po otrzymaniu oferty sam decydujesz, czy chcesz ją zaakceptować.'],
  ['Jakie informacje są potrzebne do wyceny?', 'Podaj markę, model, rocznik, przybliżony przebieg, rodzaj paliwa oraz krótki opis stanu samochodu. Ważna jest również lokalizacja pojazdu i informacja, czy auto odpala.'],
  ['Czy muszę dodawać zdjęcia samochodu?', 'Nie, ale warto je dołączyć. Zdjęcia całego auta, wnętrza, licznika i ewentualnych uszkodzeń pozwalają dokładniej ocenić zgłoszenie przed oględzinami.'],
  ['Czy wycena z formularza jest ostateczna?', 'Na podstawie formularza przygotowujemy wstępną ocenę. Ostateczną ofertę przedstawiamy po obejrzeniu samochodu i potwierdzeniu jego rzeczywistego stanu.'],
  ['Co dzieje się po wysłaniu formularza?', 'Analizujemy przesłane informacje, a następnie kontaktujemy się pod wskazanym numerem. Uzupełniamy potrzebne dane i, jeśli jesteśmy zainteresowani zakupem, ustalamy termin oględzin.'],
];
---
<Base
  title="Wycena auta online | TINA Skup Aut"
  description="Opisz auto w formularzu i dołącz zdjęcia. Przygotujemy wstępną wycenę, a ostateczną ofertę przedstawimy po oględzinach. Wycena jest bezpłatna."
  path="/wycena"
  schema={[okruszki([['/wycena', 'Wycena auta']]), faqLd(FAQ)]}
>

<Chero
  okruszek="Wycena auta"
  lede="Wypełnij formularz albo po prostu zadzwoń. Opisz samochód, dołącz zdjęcia i podaj lokalizację, przygotujemy wstępną wycenę, a ostateczną ofertę przedstawimy po oględzinach."
  sub="Wycena jest bezpłatna i nie zobowiązuje do sprzedaży."
  akcje={false}
><span>Wycena <span class="gold">Twojego auta</span></span></Chero>

<Formularz strona="wycena" />

<div class="w"><section>
  <Naglowek eyebrow="FAQ" tytul='O formularzu i <span class="gold">wycenie</span>' />
  <Faq pary={FAQ} />
</section></div>

</Base>
