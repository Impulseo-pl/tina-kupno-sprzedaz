---
import Base from '../layouts/Base.astro';
import Chero from '../components/Chero.astro';
import Naglowek from '../components/Naglowek.astro';
import Formularz from '../components/Formularz.astro';
import Kroki from '../components/Kroki.astro';
import Faq from '../components/Faq.astro';
import { okruszki, faqLd } from '../dane/firma';

const FAQ: [string, string][] = [
  ['Czy wycena jest płatna?', 'Nie. Wycena i dojazd są bezpłatne i nie zobowiązują do sprzedaży. Jeśli kwota Ci nie odpowiada, nie podpisujesz umowy i nie płacisz nic.'],
  ['Muszę dodać zdjęcia?', 'Nie, to krok nieobowiązkowy. Ze zdjęciami podamy jednak pewniejszą kwotę już w pierwszej rozmowie, bo nie musimy pytać o każdy szczegół.'],
  ['Po co pole „ile chcesz za auto”?', 'Żeby skrócić rozmowę. Jeśli wiemy, na jakiej kwocie Ci zależy, od razu powiemy, czy jesteśmy w stanie ją dać, zamiast przerzucać się propozycjami.'],
  ['Nie znam dokładnego przebiegu ani pojemności. Co wtedy?', 'Wpisz przybliżone wartości i napisz o tym w uwagach. Lepszy szacunek niż puste pole — resztę doprecyzujemy przez telefon.'],
  ['Co się dzieje po wysłaniu formularza?', 'Zgłoszenie trafia bezpośrednio do nas i oddzwaniamy na podany numer. Jeśli wolisz kontakt o konkretnej porze, zaznacz to w formularzu.'],
];
---
<Base
  title="Wycena auta online — formularz bez kalkulatora | TINA"
  description="Opisz auto w formularzu, a oddzwonimy z konkretną kwotą. Bez kalkulatorów i bez widełek — wycena jest bezpłatna i nie zobowiązuje do sprzedaży."
  path="/wycena"
  schema={[okruszki([['/wycena', 'Wycena auta']]), faqLd(FAQ)]}
>

<Chero
  okruszek="Wycena auta"
  lede="Wypełnij formularz albo po prostu zadzwoń. Kwotę podaje człowiek po zapoznaniu się z autem — nie automat, który zna tylko rocznik i przebieg."
  sub="Wycena jest bezpłatna i nie zobowiązuje do sprzedaży."
  akcje={false}
><span>Wycena <span class="gold">Twojego auta</span></span></Chero>

<Formularz strona="wycena" />

<div class="w"><section>
  <Naglowek
    eyebrow="Co dalej"
    tytul='Co się dzieje <span class="gold">po wysłaniu</span>'
    opis="Zgłoszenie trafia prosto do nas — nie do żadnej centrali ani pośrednika."
  />
  <Kroki />
</section></div>

<div class="w"><section>
  <div class="proza">
    <h2>Dlaczego nie ma tu kalkulatora</h2>
    <p>Kalkulator wyceny auta wygląda profesjonalnie i przez chwilę sprawia wrażenie konkretu. Problem w tym, że taki kalkulator zna wyłącznie rocznik, przebieg i rodzaj paliwa — czyli dokładnie te rzeczy, które o realnej wartości samochodu decydują najmniej. Ten sam algorytm wyceni identycznie auto garażowane i auto po dachowaniu, bo obu przypisze ten sam wiek i ten sam licznik.</p>
    <p>Efekt jest zawsze taki sam: widełki na stronie mówią jedno, a przy aucie pada zupełnie inna kwota. My wolimy od razu powiedzieć to, co jest prawdą — konkretną kwotę podajemy po rozmowie, a nie przed nią.</p>
  </div>
</section></div>

<div class="w"><section>
  <Naglowek eyebrow="Pytania" tytul='O formularzu i <span class="gold">wycenie</span>' />
  <Faq pary={FAQ} />
</section></div>

</Base>
