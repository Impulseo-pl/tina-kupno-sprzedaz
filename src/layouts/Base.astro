---
import { SITE, FIRMA, NAW } from '../dane/firma';

export interface Props {
  title: string;
  description: string;
  path: string;              // '/ile-placimy', canonical, og:url, aria-current
  schema?: object | object[];
  ogImage?: string;
  cta?: { label: string; href: string };
}

const { title, description, path, schema, ogImage, cta } = Astro.props;
const canonical = path === '/' ? `${SITE}/` : `${SITE}${path}`;
const schematy = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const przycisk = cta ?? { label: 'Wyceń auto', href: '/wycena' };
const CSS_V = '20260915p';
// Na telefonie w pasku miesci sie tylko kilka pozycji — reszta chowa sie pod „Więcej”.
const NAW_TELEFON = ['/', '/sprzedaz', '/kontakt'];
---
<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<link rel="canonical" href={canonical}>
<title>{title}</title>
<meta name="description" content={description}>
<meta name="theme-color" content="#06070a">
<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:locale" content="pl_PL">
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage ?? `${SITE}/img/og.jpg`}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" type="image/png" href="/img/ikona.png">
<link rel="apple-touch-icon" href="/img/ikona.png">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Manrope:wght@400;500;600;700;800&family=Unbounded:wght@600;700;800&display=swap">
<link rel="stylesheet" href={`/assets/styles.css?v=${CSS_V}`}>

<!-- Strona jest w budowie i celowo zamknieta przed wyszukiwarkami.
     Zdjac razem z robots.txt w dniu uruchomienia na tinaskupaut.pl. -->
<meta name="robots" content="noindex, nofollow">

{schematy.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</head>
<body>
<header class="top">
  <div class="w">
    <span class="logo-slot"><a class="logo" href="/" aria-label="TINA Skup Aut, strona główna"><img class="l-jasne" src="/img/logo.png" width="626" height="245" alt="TINA Skup Aut"><img class="l-ciemne" src="/img/logo-ciemne.png" width="626" height="245" alt="" aria-hidden="true"></a></span>
    <nav class="nav" aria-label="Główna">
      {NAW.map((p) => <a href={p.href} class={NAW_TELEFON.includes(p.href) ? undefined : 'tylko-duzy'} aria-current={p.href === path ? 'page' : undefined}>{p.label}</a>)}
      <button class="wiecej" type="button" aria-expanded="false" aria-controls="menu-wiecej">Więcej<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></button>
    </nav>
    <a class="tel" href={`tel:${FIRMA.tel1tel}`}><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>{FIRMA.tel1}</a>
  </div>
  <div class="menu-wiecej" id="menu-wiecej" hidden>
    {NAW.filter((p) => !NAW_TELEFON.includes(p.href)).map((p) => <a href={p.href} aria-current={p.href === path ? 'page' : undefined}>{p.label}</a>)}
  </div>
</header>
<div class="prog"></div>

<main id="app">
<slot />
</main>

<footer class="foot">
  <div class="w">
    <div class="cols">
      <div>
        <h4>TINA Skup Aut</h4>
        <p>{FIRMA.podmiot}<br>{FIRMA.ulica}<br>{FIRMA.kod} {FIRMA.miasto}<br>k. Sochaczewa, woj. mazowieckie</p>
        <p style="margin-top:12px">Skup i sprzedaż samochodów na terenie całego Mazowsza. W motoryzacji od {FIRMA.wBranzyOd} roku.</p>
      </div>
      <div>
        <h4>Kontakt</h4>
        <p><a href={`tel:${FIRMA.tel1tel}`}>{FIRMA.tel1}</a><br><a href={`tel:${FIRMA.tel2tel}`}>{FIRMA.tel2}</a><br><a href={`mailto:${FIRMA.mail}`}>{FIRMA.mail}</a><br><a href={FIRMA.fb} rel="noopener" target="_blank">Facebook</a></p>
        <p style="margin-top:12px">Odbieramy 7 dni w tygodniu.</p>
      </div>
      <div>
        <h4>Skup aut</h4>
        <p><a href="/">Skup aut za gotówkę</a><br><a href="/ile-placimy">Ile płacimy</a><br><a href="/auta-uszkodzone-powypadkowe">Auta uszkodzone i powypadkowe</a><br><a href="/skup-aut-dostawczych">Samochody dostawcze</a><br><a href="/wycena">Wycena online</a></p>
      </div>
      <div>
        <h4>Więcej</h4>
        <p><a href="/skup-aut-sochaczew">Skup aut Sochaczew</a><br><a href="/skup-aut-warszawa">Skup aut Warszawa</a><br><a href="/sprzedaz">Samochody na sprzedaż</a><br><a href="/jak-sprzedac-auto">Jak sprzedać auto</a><br><a href="/komis-czy-skup-aut">Komis czy skup</a><br><a href="/blog">Blog</a><br><a href="/o-nas">O nas</a><br><a href="/pytania">Pytania i odpowiedzi</a></p>
      </div>
    </div>
    <div class="fine">
      <span>{FIRMA.podmiot} · NIP {FIRMA.nip} · REGON {FIRMA.regon} · w motoryzacji od {FIRMA.wBranzyOd} roku</span>
      <span><a href="/polityka-prywatnosci">Polityka prywatności</a> · realizacja: <a href="https://impulseo.pl" rel="noopener">Impulseo</a></span>
    </div>
  </div>
</footer>

<div class="ctabar">
  <a class="c1" href={`tel:${FIRMA.tel1tel}`}><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .3 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>Zadzwoń</a>
  <a class="c2" href={przycisk.href}>{przycisk.label}</a>
</div>

<div class="lb" role="dialog" aria-modal="true" aria-label="Powiększone zdjęcie">
  <img src="" alt="">
  <div class="cap"></div>
  <button class="x" type="button" aria-label="Zamknij">&times;</button>
  <button class="p" type="button" aria-label="Poprzednie zdjęcie">&lsaquo;</button>
  <button class="n" type="button" aria-label="Następne zdjęcie">&rsaquo;</button>
</div>
<script src={`/assets/app.js?v=${CSS_V}`} defer is:inline></script>
</body>
</html>
