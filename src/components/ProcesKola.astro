---
/* Proces w krokach — numerowane kola z kreskami.
   Domyslnie opisuje skup na pelnej szerokosci; wariant "pion" to skrot
   w waskiej kolumnie, bez akapitow pod tytulami. */
const SKUP: [string, string][] = [
  ['Zadzwoń albo wyślij formularz', 'Podajesz markę, rocznik, przebieg, stan auta i kwotę, jakiej oczekujesz.'],
  ['Ustalamy cenę przez telefon', 'Przed przyjazdem i oględzinami na miejscu ustalamy wstępną kwotę telefonicznie.'],
  ['Przyjeżdżamy tego samego dnia', 'Oglądamy auto i robimy krótką jazdę. Bez rzeczoznawcy i bez kolejnego terminu.'],
  ['Umowa, gotówka, laweta', 'Piętnaście minut na miejscu. Pieniądze dostajesz, zanim auto wjedzie na lawetę.'],
];
const { kroki = SKUP, pion = false, trzy = false } = Astro.props;
---
<div class={pion ? 'proces pion' : trzy ? 'proces trzy' : 'proces'}>
  {kroki.map(([tytul, opis]: [string, string?], i: number) => (
    <div class="krok">
      <div class="nr">{i + 1}</div>
      <div class="tresc">
        <h3>{tytul}</h3>
        {opis && <p>{opis}</p>}
      </div>
    </div>
  ))}
</div>
