---
import Telefon from './Telefon.astro';
const {
  tytul = 'Sprawdź, ile <span class="gold">dostaniesz za swoje auto</span>',
  opis = 'Wycena jest bezpłatna i do niczego nie zobowiązuje. Dojazd i laweta są po naszej stronie — także wtedy, gdy ostatecznie się nie dogadamy.',
} = Astro.props;
---
<div class="darker"><div class="w"><section style="text-align:center">
  <p class="eyebrow">Jeden telefon i masz to z głowy</p>
  <h2 style="margin-top:14px;font-size:clamp(22px,3.1vw,38px)" set:html={tytul} />
  <p style="margin:18px auto 0;font-size:17px;color:var(--onk-mut);max-width:62ch" set:html={opis} />
  <div class="acts" style="margin-top:28px;display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
    <a class="btn g" href="/wycena">Wyceń auto online</a>
    <Telefon />
  </div>
</section></div></div>
