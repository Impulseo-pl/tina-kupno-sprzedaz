  { n: 'Legionowo',            lon: 20.9270, lat: 52.3973 },
  { n: 'Nowy Dwór Mazowiecki', lon: 20.7176, lat: 52.4318 },
  { n: 'Wyszogród',            lon: 20.1878, lat: 52.3891 },
  { n: 'Mińsk Mazowiecki',     lon: 21.5720, lat: 52.1794 },
];

const znaczniki = MIASTA.map((m) => {
  const [x, y] = pozycja(m.lon, m.lat);
  return { ...m, x, y };
});
---
<figure class="mapa-woj">
  <svg viewBox="378 158 312 320" role="img"
       aria-label="Mapa województwa mazowieckiego z miejscowościami, w których odbieramy auta">
    <path d={OBRYS} class="obrys" />
    {znaczniki.map((m) => (
      <g class={m.baza ? 'pin baza' : 'pin'}>
        {m.baza && <circle cx={m.x} cy={m.y} r="8" class="aura" />}
        <circle cx={m.x} cy={m.y} r={m.baza ? 4 : 2.5} />
        {m.etykieta === 'lewo' && <text x={m.x - 6} y={m.y + 2.6} text-anchor="end">{m.n}</text>}
        {m.etykieta === 'prawo' && <text x={m.x + 6} y={m.y + 2.6}>{m.n}</text>}
        {!m.etykieta && <title>{m.n}</title>}
      </g>
    ))}
  </svg>
  <figcaption>
    <span class="leg"><i class="b"></i>Sochaczew — nasza baza</span>
    <span class="leg"><i></i>miejscowości, w których bywamy regularnie</span>
  </figcaption>
</figure>
