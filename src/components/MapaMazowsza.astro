---
/* Uproszczony zarys wojewodztwa mazowieckiego z zaznaczonymi miejscowosciami.
   Rysowany z wspolrzednych geograficznych, zeby punkty lezaly tam, gdzie naprawde leza:
   rzut rownoodleglosciowy ze skalowaniem dlugosci przez cosinus szerokosci srodkowej. */

/* Granica wojewodztwa mazowieckiego — prawdziwy przebieg z OpenStreetMap,
   uproszczony algorytmem Ramera-Douglasa-Peuckera z 21 801 do 152 punktow.
   Format: "dlugosc szerokosc" oddzielone przecinkami. Licencja ODbL wymaga
   podpisu pod mapa — jest w figcaption. */
const GRANICA_TXT =
  '19.2592 52.4426,19.3222 52.3484,19.4549 52.3501,19.6364 52.2557,19.8475 52.2721,19.8910 52.3113,' +
  '20.0421 52.2577,20.0909 52.1526,20.2688 52.1007,20.1985 52.0258,20.2942 51.9671,20.2436 51.9334,' +
  '20.3184 51.9123,20.4202 51.9479,20.4983 51.8895,20.5708 51.8879,20.6198 51.8216,20.5578 51.8189,' +
  '20.5826 51.7480,20.6584 51.7240,20.6532 51.6771,20.5966 51.6572,20.4670 51.6971,20.3850 51.6416,' +
  '20.4675 51.5607,20.4524 51.5038,20.5199 51.5098,20.5340 51.4625,20.4167 51.3621,20.5085 51.3301,' +
  '20.5437 51.2312,20.6068 51.2468,20.7003 51.1960,20.6852 51.1513,20.7184 51.1727,20.7822 51.1453,' +
  '20.8216 51.1784,20.8798 51.1544,20.9207 51.1953,20.9985 51.1445,21.0567 51.1571,21.0700 51.2115,' +
  '21.1200 51.1887,21.0913 51.1551,21.1641 51.1285,21.1528 51.0803,21.3555 51.0853,21.4636 51.0131,' +
  '21.5122 51.0595,21.6762 51.0780,21.7591 51.0373,21.8030 51.0721,21.7874 51.1990,21.8601 51.2747,' +
  '21.7830 51.2937,21.8538 51.3517,21.7613 51.4058,21.8397 51.4175,21.8732 51.4749,21.8250 51.5615,' +
  '21.6948 51.5705,21.6155 51.6176,21.6472 51.6603,21.7493 51.6120,21.9033 51.7041,21.8353 51.7445,' +
  '21.9564 51.7939,21.9274 51.8379,21.8453 51.8412,21.9129 51.8865,21.8803 51.9710,22.0299 52.0217,' +
  '22.2536 52.0045,22.2975 52.0375,22.3444 51.9960,22.5055 52.0699,22.6229 52.0187,22.6994 52.1178,' +
  '22.7836 52.0687,22.9023 52.0636,22.8930 52.1021,22.9683 52.1154,22.9331 52.1365,22.9771 52.1723,' +
  '23.0715 52.1704,23.0313 52.2165,23.1284 52.2878,23.0514 52.2854,22.9572 52.3682,22.7279 52.3663,' +
  '22.5663 52.4034,22.5267 52.5212,22.4065 52.6101,22.4736 52.6462,22.4538 52.7882,22.3786 52.7944,' +
  '22.3284 52.7412,22.2425 52.8328,22.3051 52.8394,22.2794 52.8861,22.1242 52.8427,22.0039 52.8779,' +
  '22.0018 52.9723,21.8757 53.0163,21.9407 53.0380,21.9388 53.0745,21.8718 53.0589,21.8088 53.1152,' +
  '21.6944 53.1381,21.6891 53.2150,21.6227 53.2664,21.6583 53.2618,21.6581 53.3161,21.7354 53.3127,' +
  '21.6523 53.3313,21.6840 53.3681,21.6041 53.4818,21.4326 53.4628,21.4450 53.4374,21.3516 53.4143,' +
  '21.2503 53.4197,21.0558 53.3346,20.9363 53.3598,20.8514 53.2926,20.7166 53.3121,20.6573 53.2515,' +
  '20.5547 53.2245,20.4584 53.2468,20.3254 53.1603,20.3538 53.1471,20.1405 53.1413,20.1041 53.1681,' +
  '19.9782 53.1439,19.8931 53.2132,19.8254 53.1733,19.8411 53.1410,19.7776 53.1550,19.6342 53.1117,' +
  '19.6848 52.9630,19.5547 52.9901,19.5825 52.9569,19.4449 52.9475,19.5161 52.8601,19.4237 52.8155,' +
  '19.5271 52.7049,19.4413 52.7230,19.4509 52.6722,19.3679 52.6283,19.4193 52.5994,19.3196 52.5349,' +
  '19.3957 52.5129,19.2592 52.4426';

const GRANICA: [number, number][] = GRANICA_TXT.split(',').map((para) => {
  const [lo, la] = para.trim().split(' ').map(Number);
  return [lo, la] as [number, number];
});

type Miasto = { nazwa: string; lon: number; lat: number; baza?: boolean; etykieta?: boolean; lewo?: boolean };
const MIASTA: Miasto[] = [
  { nazwa: 'Sochaczew',           lon: 20.24, lat: 52.23, baza: true, etykieta: true, lewo: true },
  { nazwa: 'Warszawa',            lon: 21.01, lat: 52.23, etykieta: true },
  { nazwa: 'Płock',               lon: 19.71, lat: 52.55, etykieta: true, lewo: true },
  { nazwa: 'Radom',               lon: 21.15, lat: 51.40, etykieta: true, lewo: true },
  { nazwa: 'Żyrardów',            lon: 20.45, lat: 52.05 },
  { nazwa: 'Grodzisk Mazowiecki', lon: 20.63, lat: 52.11 },
  { nazwa: 'Błonie',              lon: 20.61, lat: 52.20 },
  { nazwa: 'Ożarów Mazowiecki',   lon: 20.81, lat: 52.21 },
  { nazwa: 'Pruszków',            lon: 20.81, lat: 52.17 },
  { nazwa: 'Piaseczno',           lon: 21.02, lat: 52.08 },
  { nazwa: 'Legionowo',           lon: 20.93, lat: 52.40 },
  { nazwa: 'Nowy Dwór Mazowiecki',lon: 20.72, lat: 52.43 },
  { nazwa: 'Wyszogród',           lon: 20.19, lat: 52.39 },
  { nazwa: 'Ciechanów',           lon: 20.62, lat: 52.88 },
  { nazwa: 'Ostrołęka',           lon: 21.57, lat: 53.08 },
  { nazwa: 'Siedlce',             lon: 22.28, lat: 52.17 },
  { nazwa: 'Mińsk Mazowiecki',    lon: 21.57, lat: 52.18 },
  { nazwa: 'Garwolin',            lon: 21.62, lat: 51.90 },
];

const LAT0 = 52.3;
const K = Math.cos((LAT0 * Math.PI) / 180);
const rzut = (lon: number, lat: number): [number, number] => [lon * K, -lat];

const punkty = GRANICA.map(([lo, la]) => rzut(lo, la));
const xs = punkty.map((p) => p[0]);
const ys = punkty.map((p) => p[1]);
const minX = Math.min(...xs), maxX = Math.max(...xs);
const minY = Math.min(...ys), maxY = Math.max(...ys);

const SZER = 440;
const MARG = 14;
const skala = (SZER - 2 * MARG) / (maxX - minX);
const WYS = Math.round((maxY - minY) * skala + 2 * MARG);

const naEkran = (lon: number, lat: number): [number, number] => {
  const [x, y] = rzut(lon, lat);
  return [
    Math.round(((x - minX) * skala + MARG) * 10) / 10,
    Math.round(((y - minY) * skala + MARG) * 10) / 10,
  ];
};

const sciezka =
  punkty
    .map((_, i) => {
      const [x, y] = naEkran(GRANICA[i][0], GRANICA[i][1]);
      return `${i === 0 ? 'M' : 'L'}${x} ${y}`;
    })
    .join(' ') + ' Z';

const znaczniki = MIASTA.map((m) => {
  const [x, y] = naEkran(m.lon, m.lat);
  return { ...m, x, y };
});
---
<figure class="mapa-woj">
  <svg viewBox={`0 0 ${SZER} ${WYS}`} role="img" aria-label="Mapa województwa mazowieckiego z zaznaczonymi miejscowościami, w których odbieramy auta">
    <path d={sciezka} class="obrys" />
    {znaczniki.map((m) => (
      <g class={m.baza ? 'pin baza' : 'pin'}>
        {m.baza && <circle cx={m.x} cy={m.y} r="11" class="aura" />}
        <circle cx={m.x} cy={m.y} r={m.baza ? 5 : 3.4} />
        {m.etykieta && (
          <text
            x={m.lewo ? m.x - 10 : m.x + 10}
            y={m.y + 4}
            text-anchor={m.lewo ? 'end' : 'start'}>{m.nazwa}</text>
        )}
      </g>
    ))}
  </svg>
  <figcaption>
    <span class="leg"><i class="b"></i>Sochaczew — nasza baza</span>
    <span class="leg"><i></i>miejscowości, w których bywamy regularnie</span>
    <span class="zrodlo">granice: © OpenStreetMap</span>
  </figcaption>
</figure>
