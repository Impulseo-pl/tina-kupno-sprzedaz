  { n: 'Ciechanów',            lon: 20.6200, lat: 52.8811, etykieta: 'lewo' },
  { n: 'Ostrołęka',            lon: 21.5745, lat: 53.0860, etykieta: 'prawo' },
  { n: 'Siedlce',              lon: 22.2900, lat: 52.1676, etykieta: 'prawo' },
  { n: 'Garwolin',             lon: 21.6154, lat: 51.8996, etykieta: 'prawo' },
