const pozycja = (lon: number, lat: number): [number, number] => [
  Math.round((75.8234 * lon - 1070.5705) * 10) / 10,
  Math.round((-122.9247 * lat + 6740.6805) * 10) / 10,
];

type Miasto = { n: string; lon: number; lat: number; baza?: boolean; etykieta?: 'lewo' | 'prawo' };
const MIASTA: Miasto[] = [
  { n: 'Sochaczew',            lon: 20.2373, lat: 52.2296, baza: true, etykieta: 'lewo' },
